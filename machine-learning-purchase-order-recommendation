":"ok","timestamp":1773547207771,"user_tz":-420,"elapsed":418,"user":{"displayName":"Surya Ramadhani","userId":"08778145063088767311"}},"outputId":"9ffa4016-c9b3-4067-efe5-f37f8ebd44c2"},"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["MAE Linear Regression: 11.396778741869175\n","MAE Random Forest:  3.2090123456790165\n"]}]},{"cell_type":"code","source":["# MAE values\n","models = [\"Linear Regression\", \"Random Forest\"]\n","mae_values = [mae_linear_regression, mae_random_forest]\n","\n","plt.figure(figsize=(6, 4))\n","plt.bar(models, mae_values)\n","\n","plt.title(\"MAE Comparison of Models\")\n","plt.xlabel(\"Model\")\n","plt.ylabel(\"Mean Absolute Error (MAE)\")\n","\n","# display MAE value above the bar\n","for i, v in enumerate(mae_values):\n","    plt.text(i, v, f\"{v:.2f}\", ha=\"center\", va=\"bottom\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":407},"id":"E6yUHSxqQEuY","executionInfo":{"status":"ok","timestamp":1773547207886,"user_tz":-420,"elapsed":116,"user":{"displayName":"Surya Ramadhani","userId":"08778145063088767311"}},"outputId":"0e42e462-43b2-41c1-c151-1f9d58a7adda"},"execution_count":40,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#### Mean Absolute Error represents the average absolute difference between\n","- actual value (po_based_qty)\n","- model predicted value\n","\n","Printed results:\n","- MAE Linear Regression: 9.513860903232995\n","- MAE Random Forest: 5.11877777777778\n","\n","Interpretation:\n","- Linear Regression is off by an average of about 9-10 PO quantity units per item.\n","- Random Forest is off by an average of about 5 PO quantity units per item."],"metadata":{"id":"Ua9phGeNQ2ph"}},{"cell_type":"markdown","source":["### Visualization Model Result (Predicted vs Actual)"],"metadata":{"id":"hH6utwbOmd-d"}